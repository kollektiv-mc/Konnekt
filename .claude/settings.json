{
  "extraKnownMarketplaces": {
  "kollektiv": { "source": { "source": "github", "repo": "sandrogekeler/kollektiv" } },
  "omc": { "source": { "source": "github", "repo": "Yeachan-Heo/oh-my-claudecode" } }
},
"enabledPlugins": {
  "suite-kit@kollektiv": true,
  "oh-my-claudecode@omc": true
},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ]
  }
}
