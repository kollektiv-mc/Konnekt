        "id": "source",
        "label": "Source",
        "type": "string"
      },
      {
        "id": "prefix",
        "label": "Key prefix",
        "type": "string"
      }
    ],
    "dataOutputs": [
      {
        "id": "uploaded",
        "label": "Objects uploaded",
        "type": "number"
      },
      {
        "id": "skipped",
        "label": "Objects skipped",
        "type": "number"
      },
      {
        "id": "bytes",
        "label": "Bytes sent",
        "type": "number"
      }
    ],
    "configSchema": [
      {
        "key": "destination",
        "label": "Destination",
        "type": "destination",
        "required": true
      },
      {
        "key": "source",
        "label": "Source (file or folder)",
        "type": "string",
        "required": true
      },
      {
        "key": "prefix",
        "label": "Key prefix",
        "type": "string"
      }
    ],
    "source": "native",
    "timeoutSeconds": 43200
  },
