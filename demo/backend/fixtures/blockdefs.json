  {
    "id": "action.dhPublish",
    "category": "action",
    "label": "Publish DH Snapshot",
    "description": "Uploads a staged Distant Horizons snapshot to a saved bucket destination, builds each level's whole database in the bucket from the uploaded parts, and writes the download page. latest.json is written last, so a reader never sees a snapshot whose files are missing. Afterwards it keeps the newest snapshots and deletes the older ones and the parts only they used; a failure to do that is a warning, not a failed run. The server is not touched.",
    "isTrigger": false,
    "controlInputs": [
      "trigger"
    ],
    "controlOutputs": [
      "onComplete",
      "onFailed"
    ],
    "dataInputs": [
      {
        "id": "folder",
        "label": "Staged folder",
        "type": "string"
      }
    ],
    "dataOutputs": [
      {
        "id": "url",
        "label": "Snapshot URL",
        "type": "string"
      },
      {
        "id": "partsUploaded",
        "label": "Parts uploaded",
        "type": "number"
      },
      {
        "id": "partsSkipped",
        "label": "Parts skipped",
        "type": "number"
      },
      {
        "id": "bytesSent",
        "label": "Bytes sent",
        "type": "number"
      },
      {
        "id": "levelsAssembled",
        "label": "Levels assembled",
        "type": "number"
      },
      {
        "id": "snapshotsDeleted",
        "label": "Snapshots deleted",
        "type": "number"
      },
      {
        "id": "partsDeleted",
        "label": "Parts deleted",
        "type": "number"
      },
      {
        "id": "bytesFreed",
        "label": "Bytes freed",
        "type": "number"
      }
    ],
    "configSchema": [
      {
        "key": "destination",
        "label": "Destination",
        "type": "destination",
        "required": true
      },
      {
        "key": "prefix",
        "label": "Key prefix",
        "type": "string"
      },
      {
        "key": "folder",
        "label": "Staged folder (default: this server's staging folder)",
        "type": "string"
      },
      {
        "key": "keep",
        "label": "Snapshots to keep (at least 1)",
        "type": "number",
        "default": 3
      }
    ],
    "source": "native",
    "timeoutSeconds": 43200
  },
  {
    "id": "action.dhSnapshot",
    "category": "action",
    "label": "Distant Horizons Snapshot",
    "description": "Stops the server to copy its Distant Horizons data into a staged snapshot, then starts it again. Players are warned first, over RCON or the console. Only the parts that changed since the last snapshot are staged, and the staged folder wires into Upload to Bucket.",
    "isTrigger": false,
    "controlInputs": [
      "trigger"
    ],
    "controlOutputs": [
      "onComplete",
      "onFailed"
    ],
    "dataInputs": null,
    "dataOutputs": [
      {
        "id": "folder",
        "label": "Staged folder",
        "type": "string"
      },
      {
        "id": "bytesChanged",
        "label": "Bytes changed",
        "type": "number"
      },
      {
        "id": "partsChanged",
        "label": "Parts changed",
        "type": "number"
      },
      {
        "id": "partsTotal",
        "label": "Parts in all",
        "type": "number"
      },
      {
        "id": "downtime",
        "label": "Downtime (s)",
        "type": "number"
      }
    ],
    "configSchema": [
      {
        "key": "destination",
        "label": "Destination of the last snapshot",
        "type": "destination"
      },
      {
        "key": "prefix",
        "label": "Key prefix",
        "type": "string"
      },
      {
        "key": "output",
        "label": "Staging folder (default: in the app data folder)",
        "type": "string"
      },
      {
        "key": "leadSeconds",
        "label": "Warn players this many seconds before",
        "type": "number",
        "default": 300
      },
      {
        "key": "message",
        "label": "Warning ({time} is the time left)",
        "type": "string",
        "default": "The server will stop in {time} for a world snapshot and be back shortly."
      }
    ],
    "source": "native",
    "timeoutSeconds": 10800,
    "effects": [
      "stopsServer"
    ]
  },
